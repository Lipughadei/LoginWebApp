const Cart = require('./Cart');

describe('Cart', () => {
    let cart;

    beforeEach(() => {
        cart = new Cart();
    });

    test('should add an item to the cart', () => {
        const item = { id: 1, name: 'Laptop', price: 1000 };
        cart.addItem(item);
        expect(cart.items).toContain(item);
    });

    test('should remove an item from the cart', () => {
        const item1 = { id: 1, name: 'Laptop', price: 1000 };
        const item2 = { id: 2, name: 'Phone', price: 500 };
        cart.addItem(item1);
        cart.addItem(item2);
        cart.removeItem(1);
        expect(cart.items).not.toContain(item1);
        expect(cart.items).toContain(item2);
    });

    test('should calculate the total price of items in the cart', () => {
        const item1 = { id: 1, name: 'Laptop', price: 1000 };
        const item2 = { id: 2, name: 'Phone', price: 500 };
        cart.addItem(item1);
        cart.addItem(item2);
        expect(cart.getTotal()).toBe(1500);
    });

    test('should clear the cart', () => {
        const item = { id: 1, name: 'Laptop', price: 1000 };
        cart.addItem(item);
        cart.clear();
        expect(cart.items).toHaveLength(0);
    });
});
Explanation
Setup: We create a new instance of the Cart class before each test using beforeEach().
Adding Items: The first test checks if an item can be added to the cart.
Removing Items: The second test verifies that an item can be removed from the cart.
Calculating Total: The third test checks if the total price of items in the cart is calculated correctly.
Clearing the Cart: The last test ensures that the cart can be cleared.
